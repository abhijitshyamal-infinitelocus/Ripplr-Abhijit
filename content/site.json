            "label": "Full Name",
            "placeholder": "Enter full name",
            "type": "text",
            "validate": "name",
            "half": true,
            "required": true
          },
          {
            "name": "mobile",
            "label": "Mobile No",
            "placeholder": "98xxxxxx",
            "type": "tel",
            "half": true,
            "required": true
          },
          {
            "name": "from",
            "label": "From",
            "placeholder": "Pickup city",
            "type": "text",
            "half": true,
            "required": true
          },
          {
            "name": "to",
            "label": "To",
            "placeholder": "Delivery city",
            "type": "text",
            "half": true,
            "required": true
          },
          {
            "name": "goodsType",
            "label": "Select type",
            "placeholder": "Select type",
            "type": "select",
            "half": true,
            "required": false,
            "options": [
              "Document",
              "FMCG",
              "Apparel",
              "Electronics",
              "Food",
              "Furniture",
              "Others"
            ]
          },
          {
            "name": "weight",
            "label": "Weight (in Kg)",
            "placeholder": "e.g. 250",
            "type": "number",
            "half": true,
            "required": true

    "panels": [
      {
        "id": "transport",
        "eyebrow": "Transport",
        "title": "We specialize in mid-mile.",
        "body": "The mid-mile is the leg between your warehouse and your store, dark store or distribution point - the leg where reliability compounds. We run it for retail and FMCG operators including Seven Eleven, Reliance Trends and Licious, primarily by road, with air lanes for clients who need speed over distance.",
        "steps": [
          {
            "title": "We map your network",
            "body": "Before a single trip runs, we study your outlets, volumes and service windows, then design the lanes around them. You get a network plan and a per-km number, not a generic rate card.",
            "art": "/figma/logistics/step-1.webp",
            "video": "/figma/logistics/step-1.webm",
            "videoMp4": "/figma/logistics/step-1.mp4"
          },
          {
            "title": "We run it and watch it",
            "body": "Every trip streams live position and ETA to our control tower. When a lane slips, we know before your SLA does, and there is still time to reroute.",
            "art": "/figma/logistics/step-2.webp",
            "video": "/figma/logistics/step-2.webm",
            "videoMp4": "/figma/logistics/step-2.mp4"
          },
          {
            "title": "It reaches your stores on time",
            "body": "Delivery confirmed at the door, with proof against the SLA you agreed. You see the same numbers we do.",
            "art": "/figma/logistics/step-3.webp",
            "video": "/figma/logistics/step-3.webm",
            "videoMp4": "/figma/logistics/step-3.mp4"
          }
        ]
      },
      {
        "id": "warehousing",
        "eyebrow": "Warehousing",
        "title": "We don't just rent space. We manage your inventory.",
        "body": "Where stock sits, how accurately it's counted, and how fast it leaves are our numbers to hit, not yours. Built for high volume industries, where a day of stockout costs more than the storage.",
        "steps": [
          {
            "label": "Property",
            "title": "We plan the end to end supply chain",
            "body": "Facility sourcing, leasing and upkeep are ours, so you carry no real estate and no lease risk. So is the harder call: which site holds which SKU, and how close it sits to the demand that turns it.",
            "art": "/figma/logistics/Warehouse/Warehouse2.webp",
            "video": "/figma/logistics/Warehouse/warehousing.webm",
            "videoMp4": "/figma/logistics/Warehouse/warehousing.mp4"
          },
          {
            "label": "Resources",
            "title": "Every case is counted, not estimated",
            "body": "WMS, scanners and a defined SOP on every site. Stock is scanned in and scanned out, so your inventory position is a live number you can plan against, not a monthly reconciliation.",
            "art": "/figma/logistics/Warehouse/Warehouse3.webp",
            "video": "/figma/logistics/Warehouse/every-case.webm",
            "videoMp4": "/figma/logistics/Warehouse/every-case.mp4"
          },
          {
            "label": "Manpower",
            "title": "The same trained team on every shift",
            "body": "Warehouse staff are hired, trained and managed by us. Ensuring complete adherence to SLAs and SOPs.",
            "art": "/figma/logistics/Warehouse/Warehouse1.webp",
            "video": "/figma/logistics/Warehouse/trained-team.webm",
            "videoMp4": "/figma/logistics/Warehouse/trained-team.mp4"
          }
        ]
      }
    ],
    "stepLabel": "Step"
  },
